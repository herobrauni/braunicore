{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "pinDigests": true,
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "ignoreDeps": ["ghcr.io/herobrauni/braunicore"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": ["COSIGN_VERSION:\\s*v?(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "sigstore/cosign",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^system_files/usr/share/containers/systemd/beszel-agent\\.container$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nImage=ghcr\\.io/herobrauni/braunicore:beszel-(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Automerge tested uCore stable digest refreshes",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ublue-os/ucore-minimal"],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Unsigned upstream Beszel updates require provenance review",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/henrygd/beszel-agent"],
      "matchCurrentVersion": "/^0\\.18\\./",
      "matchUpdateTypes": ["digest", "patch"],
      "automerge": false
    },
    {
      "description": "Automerge tested action digest, patch, and minor updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates always require review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
