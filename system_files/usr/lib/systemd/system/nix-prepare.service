[Unit]
Description=Prepare the persistent Nix store
DefaultDependencies=no
After=ostree-remount.service
Before=nix.mount

[Service]
Type=oneshot
ExecStart=/usr/bin/install -d -o root -g root -m 0755 /var/lib/nix
ExecStart=/usr/bin/install -d -o root -g root -m 0555 /var/lib/nix/store
ExecStart=/usr/bin/install -d -o root -g root -m 0755 /var/lib/nix/var/nix/profiles
ExecStart=/usr/bin/install -d -o root -g root -m 0755 /var/lib/nix/var/nix/daemon-socket
ExecStart=/usr/sbin/restorecon -RF /var/lib/nix
RemainAfterExit=yes
